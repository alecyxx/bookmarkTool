# Bookmark Manager V1 开发环境示例配置
# 复制为 .env 后修改；.env 不得进入版本库。
APP_ENV=development
DATABASE_URL=sqlite:///dev_data/bookmarks.db

# 会话密钥：生产环境必填，至少 32 字符强随机（可执行 python -c "import secrets; print(secrets.token_hex(32))" 生成）
# SESSION_SECRET=
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAME_SITE=lax
SESSION_MAX_AGE_SECONDS=43200

# 网络搜索首页默认引擎：google / bing / baidu
DEFAULT_WEB_SEARCH_ENGINE=google

# V1 默认关闭第三方 favicon 展示
ENABLE_REMOTE_FAVICONS=false

# 可信反向代理 CIDR（逗号分隔），用于来源 IP 解析
TRUSTED_PROXIES=

# 展示时区（IANA）
TIMEZONE=UTC

LOG_LEVEL=INFO
LOG_FORMAT=text

# 上传与导入限制
MAX_UPLOAD_BYTES=10485760
MAX_IMPORT_ROWS=50000
MAX_PARSE_SECONDS=60
