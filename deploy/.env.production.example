# Bookmark Manager V1 生产环境模板（BM-V1-802）
# 复制为 deploy/.env 后填写；不要提交 .env 到版本库。
# 生产缺失 SESSION_SECRET 时应用拒绝启动（ConfigError）。

# ---- 必填 ----
# 外部域名（Caddy 使用）
DOMAIN=bookmarks.example.com

# 签名密钥（会话与 CSRF 共用 SESSION_SECRET 派生；生产缺失即拒绝启动）
# 生成方式：openssl rand -hex 32（64 字符，>= 32 字符要求）
SESSION_SECRET=__replace_with_openssl_rand_hex_32__

# ---- 可选 ----
# 镜像标签（发布固定值，如 1.0.0 / 1.1.0，不用 latest 浮动标签）
IMAGE_TAG=1.0.0

# 日志级别（production 建议 info）
LOG_LEVEL=info

# 时区数据由 tzdata 包提供，无需配置

# 密码哈希参数（默认 argon2id 常规即可，不建议下调）
