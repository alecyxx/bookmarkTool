[Unit]
Description=Qianqi Bookmark Manager
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bookmark
Group=bookmark
WorkingDirectory=/opt/bookmark/source
EnvironmentFile=/etc/bookmark/bookmark.env
ExecStart=/opt/bookmark/venv/bin/python -m uvicorn app.main:create_app --factory --host 127.0.0.1 --port 8000 --workers 1 --proxy-headers --forwarded-allow-ips 127.0.0.1
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
UMask=0077

# 1 GB VPS 资源与权限边界
MemoryHigh=384M
MemoryMax=512M
TasksMax=128
LimitNOFILE=4096
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/bookmark /var/backups/bookmark
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
