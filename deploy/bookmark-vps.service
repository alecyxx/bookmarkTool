[Unit]
Description=Qianqi Bookmark Manager
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bookmark
Group=bookmark
WorkingDirectory=/var/lib/bookmark
EnvironmentFile=/etc/bookmark/bookmark.env
Environment=HOME=/var/lib/bookmark
Environment=PEX_ROOT=/var/lib/bookmark/.pex
ExecStart=/opt/bookmark/qianqi serve
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
UMask=0077

# 1 GB VPS 资源与权限边界
MemoryHigh=384M
MemoryMax=512M
TasksMax=128
LimitNOFILE=4096
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/bookmark /var/backups/bookmark
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
