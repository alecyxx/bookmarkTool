# fnOS 可信内网 HTTP 实例；复制为 deploy/.env 后替换占位值。
APP_ENV=lan
SESSION_SECRET=__replace_with_openssl_rand_hex_32__
SESSION_COOKIE_SECURE=false
ALLOW_DOCS=false
LOG_LEVEL=info
LOG_FORMAT=json
TIMEZONE=Asia/Shanghai
IMAGE_TAG=1.0.0

BIND_IP=192.168.1.20
HTTP_PORT=18000
DATA_DIR=/replace/with/fnos/storage/bookmarkTool-data
BACKUP_DIR=/replace/with/fnos/storage/bookmarkTool-backups
